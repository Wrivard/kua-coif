# Supabase — get these from your project settings:
#   https://supabase.com/dashboard/project/<your-project>/settings/api
# The anon key is safe to expose to the browser (RLS protects data).
# The service-role key is NEVER prefixed NEXT_PUBLIC_ — server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — used only by seed/migration scripts. Never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — used by `supabase link` to associate this repo with a cloud project.
# This is the slug from the dashboard URL (the part between `/project/` and `/settings`).
SUPABASE_PROJECT_REF=your-project-ref

# Sentry — uncomment when Phase 3 wires error tracking.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Stripe — Phase 28 Connect onboarding + Phase 38 PaymentIntents + Phase 56
# Elements UI. The publishable key is safe to expose (it's literally how
# stripe.js authenticates from the browser). The secret + webhook secret
# are server-only.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
