# =============================================================================
# kua-coiffure — environment variables
#
# Copy to `.env.local` and fill in. NEVER commit real values. Vars prefixed
# NEXT_PUBLIC_ are exposed to the browser; everything else is server-only.
# Grouping:
#   REQUIRED       — the app won't boot, or customer links break, without it.
#   FEATURE-GATED  — the related feature is silently OFF when unset (no crash).
#   DEV/TEST ONLY  — only used by local tooling, tests, or CI.
# Each line notes what it turns on and the file that reads it.
# =============================================================================

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Supabase Postgres + Auth client (browser + server). Project → Settings → API.
# Anon key is safe to expose (RLS protects rows). lib/supabase/{client,server}.ts
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — bypasses RLS. Used by public flows, crons, seed scripts.
# NEVER prefix NEXT_PUBLIC_; never ship to the browser. lib/supabase/service-role.ts
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Master encryption + signing key. Encrypts every stored integration credential
# (SMTP/Google/QuickBooks/Twilio) AND HMAC-signs every public customer token
# (/me, /receipt, /review, /reschedule, /unsubscribe). lib/crypto/aes.ts +
# lib/security/signed-tokens.ts.
#   ⚠ LOSING OR ROTATING THIS BRICKS EVERY SHOP'S STORED CREDENTIALS AND
#     INVALIDATES EVERY OUTSTANDING CUSTOMER LINK — there is no recovery.
NOTIFICATION_ENCRYPTION_KEY=generate-a-strong-32-byte-base64-secret

# Base URL used to BUILD signed customer links in emails/SMS. lib/env/app-url.ts.
# Empty ⇒ relative links (broken in email) + a one-time Sentry warning in prod.
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Canonical public site origin — robots.txt, sitemap.xml, and the fallback
# origin for auth redirect emails. app/robots.ts, app/sitemap.ts, auth actions.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# The three URLs, disambiguated (they often share one value):
#   NEXT_PUBLIC_SITE_URL  → canonical site origin (SEO + auth redirects).
#   NEXT_PUBLIC_APP_URL   → origin embedded in signed customer links.
#   APP_URL               → a GitHub Actions REPO SECRET (NOT this file): the
#                           cron workflows (.github/workflows/cron-*.yml) call
#                           ${APP_URL}/api/cron/* . Mirror NEXT_PUBLIC_APP_URL.

# ── FEATURE-GATED ────────────────────────────────────────────────────────────

# Stripe Connect — deposits / PaymentIntents / Elements. Unset ⇒ payment UI off,
# bookings proceed without a deposit. Publishable key is browser-safe. lib/stripe/*
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Küa platform fee per PaymentIntent, in basis points (200 = 2%). 0/unset = none.
STRIPE_APP_FEE_BPS=

# Upstash Redis — durable rate limiting. Unset ⇒ falls back to per-instance
# in-memory limiting (works locally, not shared across serverless instances).
# lib/auth/rate-limit.ts
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend — transactional email (confirmations, reminders, review requests).
# Unset ⇒ email send is a no-op. lib/email/client.ts
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=

# Cloudflare Turnstile — bot protection on the public booking form. Both unset ⇒
# the challenge is skipped (action no-ops the check). Site key is browser-safe.
# lib/security/turnstile.ts + components/ui/turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google Calendar OAuth — barber calendar two-way sync. Unset ⇒ sync off.
# lib/google/server.ts
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# QuickBooks Online OAuth — invoice/sales sync. Unset ⇒ sync off. ENVIRONMENT is
# `sandbox` or `production`. lib/quickbooks/server.ts
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox

# Shared secret for the cron endpoints (GitHub Actions sends it as a Bearer
# header). In PRODUCTION a missing value is fail-CLOSED (cron routes deny).
# lib/security/cron-auth.ts. Mirror the same value as the GH Actions secret.
CRON_SECRET=

# Sentry — error tracking + traces. Same DSN in both vars (browser vs server).
# Unset ⇒ observability off. NEXT_PUBLIC_SENTRY_TUNNEL_ROUTE optionally proxies
# Sentry traffic through your origin to dodge ad-blockers.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TUNNEL_ROUTE=
# Source-map upload at build time (readable prod stack traces). next.config.mjs.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Fine-grained GitHub PAT gating the super-admin Sentry-autofix dashboard.
# Unset ⇒ that page returns "not set". app/[locale]/(app)/super-admin/*
# See the runbook in .github/workflows/sentry-autofix.yml.
KUA_GITHUB_TOKEN=

# ── DEV / TEST ONLY ──────────────────────────────────────────────────────────

# Supabase CLI link target (slug from the dashboard URL). `pnpm db:link`. Not
# read by app code.
SUPABASE_PROJECT_REF=your-project-ref

# Playwright e2e sign-in credentials (a seeded test user). playwright config.
PLAYWRIGHT_USER_EMAIL=
PLAYWRIGHT_USER_PASSWORD=

# Set by CI to run the Playwright job against a freshly reset local DB.
E2E_FRESH_DB=

# `pnpm analyze` sets this to emit the bundle-analyzer report. next.config.mjs.
ANALYZE=

# NODE_ENV is managed by the framework/tooling (development/production/test).
# Do NOT set it by hand in .env — listed here only because the code reads it.
