# Supabase — get these from your project settings:
#   https://supabase.com/dashboard/project/<your-project>/settings/api
# The anon key is safe to expose to the browser (RLS protects data).
# The service-role key is NEVER prefixed NEXT_PUBLIC_ — server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — used only by seed/migration scripts. Never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — used by `supabase link` to associate this repo with a cloud project.
# This is the slug from the dashboard URL (the part between `/project/` and `/settings`).
SUPABASE_PROJECT_REF=your-project-ref

# Sentry — error tracking + traces. Sign up at https://sentry.io (free
# 5k events/month tier covers a single shop comfortably). Copy the DSN
# into BOTH vars below — the public one is used by the browser SDK,
# the server one by Node.js / Edge runtimes. Same DSN is fine; we keep
# them split so a future deploy could tune sample rates differently.
# Production sample rate is 0.1 (10%); dev/preview stay at 1.0.
# SENTRY_DSN=https://<your-key>@<your-org>.ingest.sentry.io/<your-project>
# NEXT_PUBLIC_SENTRY_DSN=https://<your-key>@<your-org>.ingest.sentry.io/<your-project>

# Sentry source-map upload — enables readable production stack traces.
# Without these, minified errors show `?@app/...:1:42` instead of
# file:line. Setup:
#   1. https://sentry.io/settings/<org>/auth-tokens/ → create token with
#      `project:releases` scope (the bot account creates one per CI).
#   2. SENTRY_ORG = your sentry org slug (URL fragment before /projects)
#   3. SENTRY_PROJECT = your project slug
#   4. SENTRY_AUTH_TOKEN = the token from step 1 (server-only, NEVER
#      commit; Vercel env)
# The withSentryConfig wrapper in next.config.mjs is already wired —
# build-time source-maps upload kicks in automatically when these vars
# are present. Silent no-op otherwise (the build logs a one-line note).
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# Optional — tunnel Sentry traffic through our origin to dodge
# ad-blockers. Pick an inconspicuous path like `/api/_telemetry`.
# NEXT_PUBLIC_SENTRY_TUNNEL_ROUTE=

# Stripe — Phase 28 Connect onboarding + Phase 38 PaymentIntents + Phase 56
# Elements UI. The publishable key is safe to expose (it's literally how
# stripe.js authenticates from the browser). The secret + webhook secret
# are server-only.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Phase 19 (post-audit) — Küa platform fee on every PaymentIntent, in
# basis points (100 = 1%). 0 or unset = no fee collected; the full
# amount transfers to the shop. Example: 200 = 2%. Applies via
# Stripe Connect destination charge `application_fee_amount`.
# STRIPE_APP_FEE_BPS=
